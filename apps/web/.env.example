NEXT_PUBLIC_API_URL=http://localhost:4000
# OAuth client IDs — public by design (see docs/oauth-setup.md). Client
# secrets are server-side only, in apps/api/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Google Analytics (see components/AnalyticsGate.tsx) — set ONLY in the
# real production environment's own env-var config (Vercel/host dashboard),
# never here or in any local/.env.local file. Left unset, AnalyticsGate
# renders nothing at all — that's what keeps local dev and any
# staging/preview deploy out of the production GA4 property. The real
# value (G-KXNZGFD0RN) is not committed to this repo.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
