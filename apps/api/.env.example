# Database (matches docker-compose)
DATABASE_URL="postgresql://skillproof:localdev@localhost:5432/skillproof"
# Auth
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="15m"
# OAuth (Google/GitHub sign-in — see docs/oauth-setup.md for console config)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# App
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development
# Base URL of the deployed web app (matches skillproof-mobile's WEB_BASE_URL
# dart-define, same name/purpose) — used to build absolute links in
# notification emails. Defaults to the local Next.js dev server if unset.
WEB_BASE_URL="http://localhost:3000"
# Resume upload storage — local disk, ephemeral on Render unless a
# persistent Disk is attached and mounted at this path.
UPLOAD_DIR="./uploads"
# Email (application confirmations, status updates)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Assessment integrity tuning (optional — sane defaults if unset)
INTEGRITY_FLAG_THRESHOLD=5
RAPID_ANSWER_THRESHOLD_MS=3000
# Gate applying on having a verified badge (optional, defaults false)
REQUIRE_VERIFIED_BADGE_TO_APPLY=false
ANTHROPIC_API_KEY=""
# AI assessor session idle-expiry, in minutes (optional — sane default if unset)
ASSESSMENT_SESSION_IDLE_TIMEOUT_MINUTES=15
# Cooldown before a REJECTED conversational assessment can be retaken, in days
# (optional — defaults to 14). Set to 0 in dev to test the retake flow without
# waiting. Does not apply when the decision was INSUFFICIENT_PROBING — that
# retake is always immediate.
ASSESSMENT_RETAKE_COOLDOWN_DAYS=14
# MSG91 — production SMS delivery for phone OTP (Msg91SmsProvider, Flow API).
# In dev (NODE_ENV != production) the code is logged, not sent, so these can
# stay empty locally. In production MSG91_AUTH_KEY and MSG91_TEMPLATE_ID are
# required; SENDER_ID/OTP_VAR are optional and depend on the DLT-registered
# template. MSG91_OTP_VAR is the template variable that receives the code
# (default "otp"). JUDGE0 below is still not read by any code yet.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
MSG91_OTP_VAR=""
# Razorpay dashboard keys — used by the employer-triggered-assessment
# payment flow (RazorpaySdkGateway, assessment-requests module) to create
# orders and issue refunds. KEY_ID is also sent to the browser (Razorpay
# Checkout needs it client-side); KEY_SECRET must never leave the backend.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
JUDGE0_API_KEY=""
# City autocomplete on the candidate profile's location field (Places API,
# legacy Autocomplete + Details, restricted to city-type results — see
# GooglePlacesLocationProvider). Server-side only — never sent to the
# browser; the client only ever calls GET /locations/search. Unset means
# the search endpoint returns 503, which the web client already treats as
# "fall back to free text," so this is safe to leave blank in dev.
GOOGLE_PLACES_API_KEY=""
