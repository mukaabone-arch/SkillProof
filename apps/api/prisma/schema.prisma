// Myambii Phase 1 schema — mirrors tech spec §5 conventions:
// UUID PKs, createdAt/updatedAt everywhere, soft deletes on user-facing entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER_ADMIN
  EMPLOYER_MEMBER
  PLATFORM_ADMIN
}

enum IdentityProvider {
  PHONE
  GOOGLE
  GITHUB
}

enum SkillLevel {
  L1
  L2
  L3
  L4
}

/**
 * How a Badge's level was demonstrated. Precedence (see
 * BadgeResolverService, apps/api/src/modules/badges/badge-resolver.service.ts)
 * is DISCUSSION > TEST for the same skill+level: a reviewer watching a
 * candidate reason through a live conversation is stronger evidence than a
 * multiple-choice score. Every Badge is a permanent, unrevoked record of its
 * own issuance regardless of precedence — this enum only affects which
 * Badge a resolver picks as "the" current one for a given skill+level; nine
 * out of ten it never even applies since most skill+level pairs will only
 * ever have one format available.
 */
enum BadgeVerificationMethod {
  TEST
  DISCUSSION
}

enum ClaimStatus {
  UNVERIFIED
  VERIFIED
  EXPIRED
}

enum AttemptStatus {
  CREATED
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
  FAILED_INTEGRITY
}

// ---------- Integrity monitoring (spec: lightweight, detect-and-record) ----------
// Signals only — never treated as proof. See IntegrityEvent doc comment.

enum IntegrityEventType {
  TAB_BLUR
  TAB_FOCUS
  PASTE_ATTEMPT
  COPY_ATTEMPT
  FULLSCREEN_EXIT
  RAPID_ANSWER
  RIGHT_CLICK
  /**
   * Browser detected the PrintScreen key specifically. Partial signal only —
   * OS-level screenshot tools (Win+Shift+S Snipping Tool, a second device
   * photographing the screen, etc.) fire no browser event at all and are not
   * detectable this way. Do not treat this as screenshot prevention.
   */
  PRINT_SCREEN
}

enum IntegrityStatus {
  CLEAN
  FLAGGED
  REVIEW
  INVALIDATED
}

/**
 * An admin's decision on a FLAGGED attempt — the only thing that can invalidate an attempt/badge.
 */
enum ReviewOutcome {
  APPROVED
  INVALIDATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  LIVE
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

/**
 * Hiring-pipeline stage for a ShortlistEntry. Only SHORTLISTED is set by
 * anything today (ShortlistService.add always creates at the default) — the
 * rest exist now so the pipeline feature can PATCH an entry's stage without
 * a second migration. Distinct from ApplicationStatus.SHORTLISTED: that's a
 * per-application review status an employer sets on a candidate who applied
 * to a specific job; this is membership in the org's own shortlist
 * collection, which a candidate can join without ever applying (e.g. from
 * candidate search) and which will drive the pipeline UI next.
 */
enum ShortlistStage {
  SHORTLISTED
  INVITED
  INTERVIEWING
  OFFER
  HIRED
  DECLINED
  REJECTED
  CLOSED
  /**
   * Set only by AccountService when a candidate with a live entry
   * (INVITED/INTERVIEWING/OFFER) deactivates or deletes their account —
   * never a hiring decision by either party, so it's deliberately distinct
   * from DECLINED (candidate's own active choice to decline an invite),
   * REJECTED (employer's own active choice) and CLOSED (post-offer
   * resolution). See ShortlistEntry.preUnavailableStage for how
   * reactivation reverses this.
   */
  CANDIDATE_UNAVAILABLE
}

/**
 * The candidate's own write on an OFFER-stage entry — deliberately separate
 * from ShortlistEntry.stage (which the employer alone advances to HIRED /
 * CLOSED). See ShortlistEntry.candidateResponse's doc comment for the
 * two-write rationale: these can legitimately disagree and neither
 * overwrites the other.
 */
enum CandidateOfferResponse {
  ACCEPTED
  DECLINED
  NEGOTIATING
}

enum InterviewRoundStatus {
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
}

enum NotificationType {
  APPLICATION_CONFIRMATION
  APPLICATION_STATUS
  MATCH_DIGEST
  /**
   * Candidate: SHORTLISTED → INVITED.
   */
  PIPELINE_INVITE
  /**
   * Employer: candidate accepted or declined an invite.
   */
  PIPELINE_INVITE_RESPONSE
  /**
   * Candidate: a new InterviewRound was added.
   */
  PIPELINE_ROUND_SCHEDULED
  /**
   * Candidate: INTERVIEWING → OFFER.
   */
  PIPELINE_OFFER
  /**
   * Employer: candidate set candidateResponse on an offer.
   */
  PIPELINE_OFFER_RESPONSE
  /**
   * Candidate: → REJECTED.
   */
  PIPELINE_REJECTED
  /**
   * Employer: a candidate with a live pipeline entry (INVITED/
   * INTERVIEWING/OFFER) deactivated or deleted their account — see
   * AccountService. Never states which of the two, or why; see that
   * service's own doc comment on why the candidate's reason never reaches
   * this notification.
   */
  PIPELINE_CANDIDATE_UNAVAILABLE
  /**
   * Candidate: confirms a deactivation just took effect, and how to
   * reactivate.
   */
  ACCOUNT_DEACTIVATED
  /**
   * Candidate: confirms a deletion just took effect. Irreversible, so this
   * is the one durable record the candidate has that it happened — sent
   * before the profile's own contact fields are wiped, since it's the last
   * email this account will ever receive.
   */
  ACCOUNT_DELETED
  /**
   * Candidate: an employer paid for and requested a specific skill+level
   * assessment — see AssessmentRequestsService.payAndCreate.
   */
  ASSESSMENT_REQUEST_INVITE
  /**
   * Employer: an AssessmentRequest's candidate never started within the
   * 5-day window and the payment was refunded — see the expiry job.
   */
  ASSESSMENT_REQUEST_EXPIRED
  /**
   * Employer: the candidate finished the requested assessment and a result
   * (pass or fail) is ready to view — see the STARTED->COMPLETED
   * reconciliation.
   */
  ASSESSMENT_REQUEST_RESULT
  /**
   * Candidate: their data export (GDPR Article 20 / DPDP portability
   * request) finished generating and is ready to download — see
   * DataExportJob. No failure counterpart: a failed generation is surfaced
   * to the candidate by its status on GET /account/exports, not by email.
   */
  DATA_EXPORT_READY
  /**
   * Candidate: an employer moved a job from LIVE to CLOSED (unpublished it)
   * while this candidate had applied or was still an active (non-hired,
   * non-offer-accepted) shortlist entry for it — see
   * JobsService.notifyJobUnpublished. Wording is always neutral ("no longer
   * accepting applications") and never states or implies a reason (filled,
   * cancelled, etc.), since JobStatus.CLOSED carries no reason field itself.
   */
  JOB_UNPUBLISHED
  /**
   * Employer: sent to Organization.verificationSubmittedByUser when the
   * admin approves a PENDING verification request.
   */
  ORG_VERIFICATION_APPROVED
  /**
   * Employer: sent to Organization.verificationSubmittedByUser when the
   * admin rejects a PENDING verification request. Body includes
   * Organization.rejectionReason — the employer needs it to know what to
   * fix before resubmitting.
   */
  ORG_VERIFICATION_REJECTED
  /**
   * Employer: sent to every OrgMember when an EMPLOYER_ADMIN deactivates
   * the organization (see OrgsService.deactivate) — every member loses
   * access, not just whoever triggered it, so everyone gets told, not only
   * the admin who already knows.
   */
  ORG_DEACTIVATED
  /**
   * Employer: sent to every OrgMember when a platform admin reactivates
   * the organization (see AdminService.reactivateOrg). There is no
   * self-service reactivation — see Organization.deactivatedAt's own doc
   * comment.
   */
  ORG_REACTIVATED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ---------- External credentials (Credly-first, URL-verified) ----------

enum CredentialIssuer {
  CREDLY
  AWS
  GOOGLE
  AZURE
  NVIDIA
  DATABRICKS
  IBM
  OTHER
}

enum CredentialVerificationState {
  PENDING
  VERIFIED
  FAILED
}

/**
 * Advisory-only signal comparing the badge holder's name (when the issuer
 * exposes one) against the candidate's profile fullName. Never affects
 * verificationState or the apply-gate — see ExternalCredential.nameMatchState.
 */
enum NameMatchState {
  MATCH
  MISMATCH
  UNCHECKED
}

model User {
  id           String    @id @default(uuid())
  phone        String?   @unique
  email        String?   @unique
  passwordHash String?
  role         Role      @default(CANDIDATE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile                   CandidateProfile?
  attempts                  Attempt[]
  badges                    Badge[]
  refreshTokens             RefreshToken[]
  orgMembership             OrgMember?
  notifications             Notification[]
  reviewedAttempts          Attempt[]           @relation("AttemptReviewedBy")
  identities                Identity[]
  assessmentSessions        AssessmentSession[]
  reviewedClaimVerdicts     ClaimVerdict[]      @relation("ClaimVerdictReviewedBy")
  decidedSessions           AssessmentSession[] @relation("SessionDecidedBy")
  shortlistEntriesAdded     ShortlistEntry[]
  profileViewsMade          ProfileView[]
  interviewSessions         InterviewSession[]
  assessmentRequestsMade    AssessmentRequest[] @relation("AssessmentRequestRequestedBy")
  invitationsSent           OrgInvitation[]     @relation("OrgInvitationInvitedBy")
  adminAccessLogEntries     AdminAccessLog[]
  termsAcceptances          TermsAcceptance[]
  transactionsCreated       Transaction[]
  orgVerificationsSubmitted Organization[]      @relation("OrgVerificationSubmittedBy")
  orgVerificationsDecided   Organization[]      @relation("OrgVerificationDecidedBy")
  orgsDeactivated           Organization[]      @relation("OrgDeactivatedBy")
}

// ---------- Multi-provider auth (phone OTP, Google, GitHub) ----------

/**
 * One row per (provider, providerId) a user has signed in with. providerId is
 * the provider's own stable subject identifier (Google `sub`, GitHub numeric
 * user id, or the phone number for the PHONE provider) — never the email,
 * since emails can change or be reassigned by the provider. email/emailVerified
 * are just what that provider reported at the time of the most recent link;
 * they drive the auto-link-by-verified-email policy in AuthService and are
 * not treated as a login key.
 */
model Identity {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  provider      IdentityProvider
  providerId    String
  email         String?
  emailVerified Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

/// Evidence, written once at account creation, that a user passed through a
/// signup surface stating "you confirm you are 18 or over and agree to our
/// Terms of Service and Privacy Policy" (India DPDP Act: under-18s are
/// children whose data — including the assessment integrity telemetry —
/// needs a different consent basis). Acceptance is *passive*: continuing
/// past that line is the act, there is no checkbox. termsVersion/
/// privacyVersion pin which documents were in force at that moment (see
/// legal-terms.ts) so the row stays meaningful once those documents change.
/// One row is written per creation path (OTP, OAuth self-provision, invite
/// accept); accounts predating this model simply have none and are not
/// backfilled. Kept as its own table, not columns on User, so a future
/// re-acceptance flow can append rather than overwrite.
model TermsAcceptance {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion   String
  privacyVersion String
  // The 18-or-over confirmation the signup line states. Always true at
  // write time today (continuing is the confirmation); stored explicitly so
  // the record is self-describing rather than implied by the row existing.
  ageConfirmed   Boolean  @default(true)
  acceptedAt     DateTime @default(now())

  @@index([userId])
}

// ---------- Employer accounts (spec section: employer side, step 3a) ----------

/**
 * Admin-reviewed signal, never a gate — see Organization.verificationStatus.
 * There is exactly one platform admin, so nothing in the employer flow
 * (posting, applying, hiring, billing) may depend on this reaching VERIFIED.
 */
enum OrgVerificationStatus {
  /**
   * Default. Never submitted, or submission fields were never populated (pre-existing orgs backfilled straight to VERIFIED instead — see the add_org_verification migration).
   */
  UNVERIFIED
  /**
   * Submitted and awaiting an admin decision. verificationSubmittedAt/-ByUserId are set; verifiedAt/verifiedByUserId/rejectionReason are null — a PENDING row never carries a stale decision from a prior round.
   */
  PENDING
  /**
   * verifiedAt/verifiedByUserId set to the deciding admin/time; rejectionReason stays null.
   */
  VERIFIED
  /**
   * verifiedAt/verifiedByUserId set to the deciding admin/time; rejectionReason holds their reason.
   */
  REJECTED
}

/**
 * Structured industry dropdown for Organization.industry, same convention
 * as CandidateRoleTitle/CertIssuer — OTHER pairs with
 * Organization.industryOther for the free-text fallback. Declaration order
 * is the UI's display order (see the shared ORG_INDUSTRY_LABELS map on the
 * web side) — not alphabetical, so reordering members reorders the
 * dropdown.
 */
enum OrgIndustry {
  TECHNOLOGY_SOFTWARE
  AI_ML_PRODUCTS_SERVICES
  FINANCIAL_SERVICES_FINTECH
  HEALTHCARE_LIFE_SCIENCES
  ECOMMERCE_RETAIL
  CONSULTING_PROFESSIONAL_SERVICES
  EDUCATION_EDTECH
  MEDIA_ENTERTAINMENT
  TELECOMMUNICATIONS
  MANUFACTURING_INDUSTRIAL
  ENERGY_UTILITIES
  TRANSPORTATION_LOGISTICS
  REAL_ESTATE_PROPTECH
  GOVERNMENT_PUBLIC_SECTOR
  NON_PROFIT
  STAFFING_RECRUITMENT
  /**
   * Free-text fallback — see Organization.industryOther. Required together
   * with it at the DTO level (UpdateOrgDto's @ValidateIf), unlike
   * CandidateRoleTitle/roleTitleOther which leaves that pairing
   * UI-enforced only — industry feeds the mandatory org-setup gate (see
   * org-readiness.ts), so an OTHER with no text must never validate.
   */
  OTHER
}

model Organization {
  id            String       @id @default(uuid())
  name          String
  /**
   * Organisation-profile fields, populated from Settings. Nullable at the
   * DB level (existing orgs pre-date this rule, and the row itself must
   * exist before any of these can be filled in) — but all three are
   * mandatory before an org can use the employer portal beyond fixing this
   * exact gap: see OrgSetupCompleteGuard / org-readiness.ts for the
   * server-side enforcement, and app/employer/setup/page.tsx for where an
   * incomplete org is sent to comply. Team invitations are deliberately
   * NOT part of this gate — see DashboardService.setupChecklist's own
   * doc comment for that separate, optional nudge.
   * industryOther is meaningful only when industry is OTHER — same
   * convention as CandidateProfile.roleTitle/roleTitleOther, but validated
   * strictly (see OrgIndustry's own doc comment) since this one is
   * mandatory. No legacy free-text column here: unlike
   * CandidateProfile.locationLegacy, this replaced a String? column with
   * exactly one production row on it, and that row's value was already
   * empty — nothing to preserve (see the add_org_industry_enum migration).
   * logoKey is a bare storage key, same convention as
   * CandidateProfile.photoKey; never returned to a client directly (see
   * OrgsService's withHasLogo — `hasLogo` goes out instead).
   */
  industry      OrgIndustry?
  industryOther String?
  website       String?
  logoKey       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /**
   * Human-readable display alias (MYA-EMP-0001-style), assigned once at
   * creation time — not at verification approval, since an unverified org
   * still needs identifying in admin views and support conversations.
   * Global sequence, not per-org, via nextval('organization_code_seq') (see
   * the add_organization_code migration and org-code.util.ts's
   * generateOrgCode) — atomic under concurrent creates with no explicit
   * locking; small gaps from rolled-back creates are expected and harmless
   * for a display code. Alias only: `id` remains the
   * primary key and the only thing application code ever joins or looks up
   * on — this is never a foreign key.
   */
  code String @unique

  /**
   * See OrgVerificationStatus for what each value means and which of the
   * fields below are populated at each one. Submission fields
   * (verificationSubmittedAt/-ByUserId) and decision fields
   * (verifiedAt/verifiedByUserId/rejectionReason) are reset to null
   * whenever a REJECTED org resubmits and moves back to PENDING — a stale
   * rejection reason sitting alongside a new pending review would be
   * confusing, and the prior decision is superseded, not still true. The
   * submitter and the eventual reviewer are deliberately separate User
   * relations (an org can have more than one EMPLOYER_ADMIN, and the admin
   * who submits need not be the same one shown in a later approval, though
   * today there's only one platform admin to do the deciding).
   */
  verificationStatus            OrgVerificationStatus @default(UNVERIFIED)
  verificationSubmittedAt       DateTime?
  verificationSubmittedByUserId String?
  verificationSubmittedByUser   User?                 @relation("OrgVerificationSubmittedBy", fields: [verificationSubmittedByUserId], references: [id])
  verifiedAt                    DateTime?
  verifiedByUserId              String?
  verifiedByUser                User?                 @relation("OrgVerificationDecidedBy", fields: [verifiedByUserId], references: [id])
  rejectionReason               String?

  /**
   * Reversible, but — unlike CandidateProfile.deactivatedAt — there is no
   * self-service reactivation path, and unlike that field this one is a
   * real access gate (see OrgActiveGuard, embedded in OrgMemberGuard),
   * never a passive visibility filter: every OrgMember is blocked from the
   * whole employer portal while this is set, not just hidden from someone
   * else's query. Set by OrgsService.deactivate (EMPLOYER_ADMIN-triggered,
   * immediate, no approval workflow) alongside deactivatedByUserId — an
   * org can have more than one EMPLOYER_ADMIN, so worth recording which one
   * acted. Cleared only by AdminService.reactivateOrg (platform-admin
   * only); that decision is logged via AdminAccessLog(action:
   * 'ORG_REACTIVATED', organizationId) rather than a second attribution
   * column here — see that model's own doc comment, this is exactly the
   * org-scoped-platform-admin-action case it was added for. Deactivating
   * closes every live Job (see JobsService.update's LIVE->CLOSED path,
   * reused as-is — not duplicated) and that does NOT get undone by
   * reactivation: applicants have already been told those roles closed,
   * and re-opening them is a deliberate, separate employer action, not an
   * automatic side effect of being let back in.
   */
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  deactivatedByUser   User?     @relation("OrgDeactivatedBy", fields: [deactivatedByUserId], references: [id])

  members            OrgMember[]
  jobs               Job[]
  shortlistEntries   ShortlistEntry[]
  assessmentRequests AssessmentRequest[]
  invitations        OrgInvitation[]
  adminAccessLogs    AdminAccessLog[]
  billingProfile     BillingProfile?
}

model OrgMember {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

enum OrgInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/**
 * A pending seat reservation for a team-member invite (see
 * OrgMembersService.invite) — never contains a secret token of its own.
 * Acceptance proves email ownership via the same email-OTP machinery
 * AuthService already uses for employer signup (see
 * AuthService.requestInviteOtp/acceptInvite), so the invitation row itself
 * only needs to be *findable* by (organizationId, email), not guessable-proof.
 * A PENDING row still counts toward the org's seat cap (see
 * OrgMembersService.countUsedSeats) so an admin can't over-invite past the
 * limit while invites are outstanding; EXPIRED/REVOKED/ACCEPTED rows don't.
 */
model OrgInvitation {
  id              String              @id @default(uuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  email           String
  invitedByUserId String
  invitedBy       User                @relation("OrgInvitationInvitedBy", fields: [invitedByUserId], references: [id])
  status          OrgInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([email])
}

/**
 * Structured job-title dropdown, separate from the free-text `headline`.
 * Predefined AI/ML role categories the candidate self-selects, plus OTHER
 * with `roleTitleOther` as its free-text fallback. Display and filter only —
 * see CandidateRoleTitle's own doc comment for why this must never reach
 * scoring.ts.
 */
enum CandidateRoleTitle {
  AI_ENGINEER
  ML_ENGINEER
  PROMPT_ENGINEER
  DATA_SCIENTIST
  MLOPS_ENGINEER
  NLP_ENGINEER
  COMPUTER_VISION_ENGINEER
  RESEARCH_ENGINEER
  DATA_ENGINEER
  AI_PRODUCT_MANAGER
  /**
   * Free-text fallback — see CandidateProfile.roleTitleOther.
   */
  OTHER
}

model CandidateProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  fullName           String?
  headline           String?
  /**
   * Structured city selection from GET /locations/search (Google Places
   * Autocomplete, city-restricted — see LocationSearchService). Written
   * together as one unit whenever the candidate re-selects from the
   * dropdown; locationCity is the presence signal the rest of the app uses
   * ("has this candidate structured their location yet"). ISO 3166-1
   * alpha-2 for locationCountry (e.g. "US", "IN") — never a full country
   * name, so it sorts/filters consistently regardless of Places' display
   * locale.
   */
  locationCity       String?
  locationRegion     String?
  locationCountry    String?
  locationPlaceId    String?
  locationLat        Float?
  locationLng        Float?
  /**
   * Pre-migration free-text location value — never silently dropped (see
   * the add_structured_location migration's backfill). Candidates who
   * haven't re-selected a city from the new dropdown yet still see this as
   * their current location; ProfilesService.formatCandidateLocation shows
   * it only when locationCity is unset. Read-only from the client's point
   * of view going forward — new saves always populate the structured
   * fields above, never this column.
   */
  locationLegacy     String?
  /**
   * Independent of location entirely — a candidate open to remote work
   * shouldn't be excluded by any future location-based filter/matching just
   * because their city is far from a role's office. Added now, ahead of
   * that filtering actually existing, because retrofitting it later would
   * mean re-deriving "was this candidate open to remote" for every existing
   * profile with no source data to derive it from.
   */
  openToRemote       Boolean   @default(false)
  yearsOfExp         Float?
  aiYearsOfExp       Float?
  githubUrl          String?
  linkedinUrl        String?
  resumeS3Key        String?
  /**
   * Storage key/filename within UPLOAD_DIR, same convention as
   * resumeS3Key (see that field's doc comment on the "S3" naming being
   * legacy — still local disk for now). Never exposed to clients directly;
   * GET /profiles/me and GET /users/me expose a derived `hasPhoto`
   * boolean instead, and the actual bytes are only ever served through
   * the authenticated GET /profiles/:id/photo proxy endpoint — never a
   * public URL or presigned link. See ProfilesService for the
   * upload/serve/delete logic and its owner-only Phase-1 access check.
   */
  photoKey           String?
  completeness       Int       @default(0)
  emailNotifications Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /**
   * Reversible — see AccountService.deactivate/reactivate. Deliberately a
   * separate column from deletedAt below, not a reuse of it: deletedAt
   * already means (and, per the four existing call sites that filter on
   * it — CandidatesService.search, MatchingService.getMatches,
   * MatchDigestService.sendDigests, UsersController.me — is trusted to
   * mean) permanently gone, and overloading it to also cover a routinely
   * reversed state would leave every future reader of `deletedAt: null`
   * unable to tell which one they were actually excluding. Both columns
   * are checked together everywhere a candidate's visibility/eligibility
   * matters (see candidateVisibilityFilter in account/account.util.ts) —
   * from a caller's point of view "hidden" is one concept, but the two
   * reasons a candidate can be hidden are not the same fact and must stay
   * distinguishable at the data layer.
   */
  deactivatedAt      DateTime?
  /**
   * Permanent. Set once by AccountService.delete and never cleared —
   * unlike deactivatedAt, there is no reactivation path back from this.
   * The row itself is never removed (see AccountService.delete's own doc
   * comment on why a real SQL delete is off the table for this schema);
   * this column plus the PII-scrub it triggers *is* "deletion" here.
   */
  deletedAt          DateTime?

  /**
   * Structured role/title dropdown (roleTitleOther holds the free-text value
   * when roleTitle is OTHER). Candidate-set directly, or accepted from an
   * AI resume-parse suggestion only after the candidate confirms it in the
   * review UI — never auto-applied. Display and employer search/filter
   * only. NEVER read this in scoring.ts / matching.service.ts — matching is
   * driven solely by verified SkillClaims and verified ExternalCredentials
   * (see those models' own "never feeds match scoring" comments); this
   * field carries no verification and must not influence match scores.
   */
  roleTitle      CandidateRoleTitle?
  roleTitleOther String?

  skillClaims           SkillClaim[]
  applications          Application[]
  externalCredentials   ExternalCredential[]
  certifications        Certification[]
  shortlistEntries      ShortlistEntry[]
  subscription          Subscription?
  usageCounters         UsageCounter[]
  profileViews          ProfileView[]
  accountActions        AccountAction[]
  assessmentRequests    AssessmentRequest[]
  exportRequests        ExportRequest[]
  adminAccessLogEntries AdminAccessLog[]
  billingProfile        BillingProfile?
}

// ---------- Account lifecycle (deactivation, reactivation, deletion) ----------

enum AccountActionType {
  DEACTIVATED
  REACTIVATED
  DELETED
}

/**
 * Single-select exit-survey options offered on both deactivation and
 * deletion (see AccountService) — optional, never a gate on either action.
 * Deliberately flat/coarse rather than open-ended: fine enough for product
 * signal, never granular enough to be personally identifying on its own.
 */
enum AccountActionReason {
  FOUND_JOB_SKILLPROOF
  FOUND_JOB_ELSEWHERE
  NOT_FINDING_ROLES
  TOO_MANY_EMAILS
  PRIVACY_CONCERNS
  OTHER
}

/**
 * One row per deactivate/reactivate/delete event — the audit trail
 * AccountService.delete's own doc comment promises ("a record that an
 * account was deleted, when, and the anonymised reason, without retaining
 * the personal data itself"). A real, undeleted @relation to
 * CandidateProfile is safe here specifically because CandidateProfile is
 * never actually deleted (see that model's deletedAt doc comment) — this
 * row survives right alongside the anonymised profile it's about.
 * reasonText is the one field this table doesn't keep forever: it's
 * candidate-authored free text (the same category of personal data the
 * rest of the deletion path removes), so AccountService.delete null-'s
 * every reasonText tied to this candidate — including rows from a much
 * earlier deactivation — at the same time it anonymises the profile,
 * leaving reasonCategory (never personally identifying on its own) as the
 * durable product-analytics signal. Admin-readable via
 * AccountService.listActionsForAdmin — no dedicated UI in this pass, see
 * that method's own doc comment.
 */
model AccountAction {
  id                 String               @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile     @relation(fields: [candidateProfileId], references: [id])
  type               AccountActionType
  reasonCategory     AccountActionReason?
  reasonText         String?
  createdAt          DateTime             @default(now())

  @@index([candidateProfileId])
}

// ---------- Data export (GDPR Article 20 / DPDP portability) ----------

enum ExportRequestStatus {
  REQUESTED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

/**
 * One "download my data" request — see DataExportService/DataExportJob.
 * Generation is asynchronous: a request is created here at REQUESTED, a
 * @Cron sweep (DataExportJob) picks it up, and the same row tracks
 * PROCESSING -> READY/FAILED. fileKey is a bare UPLOAD_DIR-relative
 * filename, same convention as CandidateProfile.photoKey/resumeS3Key —
 * never a public URL; the only way to turn it into bytes is the
 * authenticated GET /account/exports/:id/download route, which also checks
 * expiresAt. A FAILED row is retried by resetting status back to
 * REQUESTED (DataExportService.retry, PLATFORM_ADMIN-only) — the same
 * sweep picks it up again, same as AssessmentRequestsRefundJob's
 * REFUND_FAILED retry contract. This is also the record the Compliance
 * Center's export-requests admin view reads — see that page's own
 * comment on why it can see status/timestamps but never the file content.
 */
model ExportRequest {
  id               String              @id @default(uuid())
  candidateId      String
  candidateProfile CandidateProfile    @relation(fields: [candidateId], references: [id])
  status           ExportRequestStatus @default(REQUESTED)
  requestedAt      DateTime            @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  /**
   * Set once the row reaches READY (completedAt + a fixed retention
   * window — see DataExportService.EXPORT_RETENTION_DAYS). The sweep
   * flips a row past this to EXPIRED and deletes the underlying file;
   * never retrievable after that, by candidate or admin.
   */
  expiresAt        DateTime?
  failureReason    String?
  fileKey          String?
  fileSizeBytes    Int?
  downloadCount    Int                 @default(0)
  lastDownloadedAt DateTime?

  @@index([candidateId, requestedAt])
  @@index([status])
}

// ---------- Admin access audit (read-side, not the write-side AccountAction
// trail above) ----------

/**
 * "Who looked at what, when" for admin reads of candidate-scoped data —
 * the counterpart to AccountAction (which audits candidate-initiated
 * writes) and to Attempt.reviewedByUserId/AssessmentSession.decidedByUserId
 * (which audit admin writes on those specific rows). Nothing in this
 * schema logged admin *reads* before this model; deliberately generic
 * (action + targetType + targetId, not a dedicated column per surface) so
 * a future admin candidate-profile-lookup view can write to the same
 * table instead of growing its own parallel log. targetId is intentionally
 * untyped/unvalidated against any specific table — this is an audit trail,
 * not a foreign key, and must keep working even after its target is
 * anonymised or gone.
 */
model AdminAccessLog {
  id                 String            @id @default(uuid())
  adminUserId        String
  adminUser          User              @relation(fields: [adminUserId], references: [id])
  action             String
  targetType         String?
  targetId           String?
  candidateProfileId String?
  candidateProfile   CandidateProfile? @relation(fields: [candidateProfileId], references: [id])
  /**
   * Org-scoped counterpart to candidateProfileId above — added for
   * BillingService so an org-owned BillingProfile/Transaction action gets
   * the same first-class, queryable logging a candidate-owned one already
   * gets, rather than being findable only via the generic targetType/
   * targetId string pair. Nullable/additive — every pre-existing row (all
   * candidate-scoped) is unaffected.
   */
  organizationId     String?
  organization       Organization?     @relation(fields: [organizationId], references: [id])
  createdAt          DateTime          @default(now())

  @@index([adminUserId, createdAt])
  @@index([candidateProfileId, createdAt])
  @@index([organizationId, createdAt])
}

// ---------- Billing (admin data capture — no payment provider integration yet) ----------

/**
 * Legal/tax billing details for either a candidate or an organization —
 * exactly one of candidateId/organizationId is ever set (enforced by a raw
 * CHECK constraint added in this model's migration, since Prisma's schema
 * DSL can't express "exactly one of these two FKs"; BillingService also
 * validates this at the service layer as defense in depth). Admin-viewable
 * and admin-editable only today — no candidate/employer self-service UI.
 * Every admin write here goes through BillingService's own logAdminAccess
 * call, never a bare Prisma update.
 */
model BillingProfile {
  id               String            @id @default(uuid())
  candidateId      String?           @unique
  candidateProfile CandidateProfile? @relation(fields: [candidateId], references: [id])
  organizationId   String?           @unique
  organization     Organization?     @relation(fields: [organizationId], references: [id])

  /**
   * legalEntityName/billingEmail/addressLine1/city/state/postalCode are
   * nullable purely to allow SubscriptionsService to auto-create a minimal
   * profile the moment a candidate's first Razorpay subscription charge
   * succeeds (see that service's ensureBillingProfile) — a candidate
   * self-checking-out for Premium has never gone through any admin-entered
   * legal/tax intake, and blocking checkout on collecting a full GST-grade
   * address was rejected as unnecessary friction for a ₹299/₹2,999 consumer
   * subscription. Every row created by BillingProfilesService (the admin
   * path, org and candidate alike — see that service's own DTO,
   * CreateBillingProfileDto, which still requires all of these) continues
   * to have all six populated; nullability here only ever describes an
   * auto-created candidate row until an admin fills the rest in by hand.
   */
  legalEntityName String?
  billingEmail    String?
  billingPhone    String?
  /**
   * India GST identification number — shape-validated at the DTO layer, no checksum verification.
   */
  gstin           String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  /**
   * 2-digit GST "place of supply" state code — distinct from `state` above
   * (a display name): this is the specific code GST invoicing needs and is
   * usually, but not always, derivable from the billing address alone.
   */
  gstStateCode String?
  postalCode   String?
  country      String  @default("IN")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /**
   * Soft delete only — same nullable-timestamp convention as CandidateProfile.deletedAt. Transactions referencing this profile are never affected by it being soft-deleted.
   */
  deletedAt DateTime?

  transactions Transaction[]

  @@index([candidateId])
  @@index([organizationId])
}

enum TransactionType {
  ASSESSMENT_REQUEST_PAYMENT
  SUBSCRIPTION_CHARGE
  REFUND
  ADJUSTMENT
  OTHER
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/**
 * Append-only financial ledger entry. amountPaise/currency/type are frozen
 * at creation forever — no service method ever updates them; a correction
 * to any of the three is posted as a new row via amendsTransactionId,
 * never an edit to this one. `status` is the one field allowed to change
 * after creation, and only through TransactionsService's own state-machine
 * transition (PENDING->SUCCEEDED, PENDING->FAILED, SUCCEEDED->REFUNDED) —
 * never a bare field overwrite, never backwards, never arbitrary.
 * Deliberately no `updatedAt`. Every other model in this schema pairs
 * createdAt with updatedAt; this one doesn't, on purpose — an updatedAt
 * column would sit here always unequal to createdAt only on a status
 * transition, quietly implying the amount/currency/type could also change
 * in place when they never do. Leaving it off is the honest signal that
 * this row's financial facts are permanent; only `status`'s own transition
 * (audit-logged like everything else here) ever touches it again.
 */
model Transaction {
  id               String         @id @default(uuid())
  billingProfileId String
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id])

  amountPaise Int
  currency    String            @default("INR")
  type        TransactionType
  status      TransactionStatus
  description String?

  /**
   * Reserved for the not-yet-integrated payment provider — nullable until
   * then, same convention as Subscription.provider/providerSubId. Opaque
   * reference strings only (Razorpay's own order/payment ids), same shape
   * as AssessmentRequest.razorpayOrderId/razorpayPaymentId — never payment
   * instrument data. Settable exactly once, null -> value, via a narrow
   * dedicated endpoint; never overwritten value -> different value.
   */
  provider          String?
  providerOrderId   String?
  providerPaymentId String?

  /**
   * Set only when this row is a correction to an earlier one — the earlier
   * row's amountPaise/currency/type/status are never touched directly; this
   * new row is the correction, referencing what it corrects. Not @unique:
   * one original transaction can accumulate more than one amendment over
   * time (e.g. a partial refund, then a later adjustment).
   */
  amendsTransactionId String?
  amendsTransaction   Transaction?  @relation("TransactionAmendments", fields: [amendsTransactionId], references: [id])
  amendments          Transaction[] @relation("TransactionAmendments")

  /**
   * Null means provider-originated — written by the Razorpay webhook
   * handler (RazorpayWebhookService.recordCharge, via
   * TransactionsService.recordSystemTransaction), with no human admin
   * behind the write. Every admin-facing method on TransactionsService
   * (create/amend/transitionStatus/attachProviderReference) still requires
   * a real adminUserId and is unaffected — this column only went nullable
   * so that one dedicated system path could exist; it is not a general
   * relaxation of the admin-actor requirement. A seeded "system" User row
   * was considered and rejected: a privileged PLATFORM_ADMIN existing
   * solely to satisfy this FK would misrepresent every audit/admin listing
   * that ever joins through it. Null is the honest representation of "no
   * human actor" — any admin-facing transaction list must render this case
   * explicitly (e.g. "System — Razorpay") rather than crashing or leaving
   * it blank.
   */
  createdByAdminId String?
  createdByAdmin   User?   @relation(fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([billingProfileId])
  @@index([amendsTransactionId])
}

// ---------- Taxonomy (spec section 4.3) ----------

model Domain {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id])
  name        String
  aliases     String[]
  // One-line summary shown on the skill-grouped assessments catalog card
  // (see AssessmentsService.getCatalog). Nullable — most seeded skills
  // predate this field and have no copy written yet; the card just omits
  // the line rather than showing a placeholder.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  claims             SkillClaim[]
  assessments        Assessment[]
  jobSkills          JobSkill[]
  badges             Badge[]
  assessmentRequests AssessmentRequest[]

  @@unique([domainId, name])
}

model SkillClaim {
  id        String           @id @default(uuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id])
  skillId   String
  skill     Skill            @relation(fields: [skillId], references: [id])
  level     SkillLevel       @default(L1)
  status    ClaimStatus      @default(UNVERIFIED)
  badgeId   String?          @unique
  badge     Badge?           @relation(fields: [badgeId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([profileId, skillId])
}

/**
 * A candidate-submitted, externally-issued credential (Credly badge, etc.),
 * kept entirely separate from the SkillClaim/Badge system: it never maps to
 * our skill taxonomy and never feeds match scoring (scoring.ts). It only
 * ever unlocks the apply-gate as an alternative to a verified SkillClaim —
 * see CandidateJobsService.assertHasVerifiedBadge.
 * name/issuer/externalId/issuedAt/expiresAt/rawMetadata are populated by
 * CredlyVerificationService from the fetched public badge data — never
 * client-supplied — and stay null until a verification attempt succeeds.
 * issuer defaults to OTHER (the "unidentified" state) until a successful
 * fetch identifies the real issuing org.
 * nameMatchState is a separate, advisory-only signal (see NameMatchState) —
 * it never influences verificationState or the apply-gate. It's UNCHECKED
 * whenever the issuer's data has no holder name to compare (the common case
 * today: Credly's public OBI assertion only exposes a hashed recipient
 * email, not a plaintext name) or the candidate has no profile fullName yet.
 */
model ExternalCredential {
  id                String                      @id @default(uuid())
  profileId         String
  profile           CandidateProfile            @relation(fields: [profileId], references: [id])
  issuer            CredentialIssuer            @default(OTHER)
  name              String?
  credentialUrl     String
  verificationState CredentialVerificationState @default(PENDING)
  nameMatchState    NameMatchState              @default(UNCHECKED)
  verifiedAt        DateTime?
  externalId        String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  rawMetadata       Json?
  createdAt         DateTime                    @default(now())

  @@unique([profileId, credentialUrl])
  @@index([profileId])
}

// ---------- Certifications (multi-issuer, supersedes ExternalCredential for new writes) ----------

/**
 * Dropdown options for Certification.issuer (spec: UAT feedback asked for
 * issuers beyond Credly). OTHER pairs with Certification.issuerOther for the
 * free-text fallback, same convention as CandidateRoleTitle/roleTitleOther.
 */
enum CertIssuer {
  CREDLY
  COURSERA
  LINKEDIN_LEARNING
  PMI
  PEOPLECERT
  AWS
  MICROSOFT
  GOOGLE
  SCRUM_ALLIANCE
  UDEMY
  EDX
  NPTEL
  OTHER
}

/**
 * Trust tier — must stay visually distinct in every UI that renders it (see
 * CertificationsPanel.tsx). VERIFIED is the only tier that ever contributes
 * to job-match scoring (see scoring.ts's certifiedSkillIds parameter) or the
 * apply-gate (CandidateJobsService.assertHasVerifiedBadge) — LINK_PROVIDED
 * and SELF_REPORTED are presentation-only, exactly like ExternalCredential's
 * PENDING/FAILED states never were allowed to influence scoring.
 * EXPIRED overrides whichever of the three tiers a row started in once its
 * expiryDate has passed — see CertificationsService.refreshExpired, which
 * lazily flips rows to EXPIRED on read rather than relying on a cron job.
 */
enum CertVerificationStatus {
  VERIFIED
  LINK_PROVIDED
  SELF_REPORTED
  EXPIRED
}

/**
 * How verificationStatus was decided — see CertificationsService.create.
 */
enum CertVerificationSource {
  CREDLY
  URL
  MANUAL_UPLOAD
}

/**
 * A candidate-submitted certification from any issuer (Credly, Coursera,
 * LinkedIn Learning, PMI, PeopleCert, plain manual entry, ...) — the
 * multi-issuer successor to ExternalCredential, which stays in place
 * read-only for its existing rows (see the 20260722000000_add_certifications
 * migration's backfill: every VERIFIED ExternalCredential row was copied
 * here with issuer CREDLY, verificationSource CREDLY, verificationStatus
 * VERIFIED, so nothing already earned is lost).
 * skillTags holds Skill.id values from the *existing* taxonomy (see the
 * Skill model / GET /taxonomy) — never a parallel/free-text tag set, so a
 * verified certification's tags can be intersected directly against a job's
 * skill requirements in scoring.ts. Only VERIFIED rows' tags are ever read
 * for scoring; LINK_PROVIDED/SELF_REPORTED tags are stored (so they're ready
 * the moment a row is later verified) but otherwise inert.
 * fileUrl stores a bare on-disk filename (UPLOAD_DIR-relative), same
 * convention as CandidateProfile.photoKey/resumeS3Key — never a public URL.
 * It's served only through the authenticated GET
 * /profiles/me/certifications/:id/file proxy, and the API's own JSON
 * response never echoes this raw column; it exposes a `fileUrl` computed as
 * that proxy path instead (see CertificationsService.toDto). This keeps the
 * field name candidates/mobile see stable and matches spec even though the
 * DB column itself is just a storage key.
 * Seam for later: an admin-managed cert-name/issuer → skill-tags mapping
 * table (to auto-suggest skillTags instead of requiring manual tagging on
 * every create) can be added without touching this model — it would just
 * populate the same skillTags array at create time. No such table exists
 * yet; CertificationsService.suggestSkillTags is the seam, returning []
 * until one does.
 */
model Certification {
  id                 String                 @id @default(uuid())
  profileId          String
  profile            CandidateProfile       @relation(fields: [profileId], references: [id])
  name               String
  issuer             CertIssuer
  issuerOther        String?
  issueDate          DateTime
  expiryDate         DateTime?
  credentialId       String?
  credentialUrl      String?
  /**
   * Bare storage key, not a URL — see this model's doc comment.
   */
  fileUrl            String?
  verificationStatus CertVerificationStatus @default(SELF_REPORTED)
  verificationSource CertVerificationSource
  skillTags          String[]               @default([])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([profileId, credentialUrl])
  @@index([profileId])
}

// ---------- Subscriptions & entitlements (foundation only — no payment
// provider integration yet; tier is set manually via the admin endpoint.
// See apps/api/src/config/plans.config.ts for the actual limits/features
// per tier — never hardcode a limit anywhere else.) ----------

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/**
 * One row per candidate who has ever been given a tier — a candidate with
 * no row here is FREE (see EntitlementsService.resolveSubscription); rows
 * are never proactively backfilled for existing candidates. tier/status
 * are set manually today via POST /admin/candidates/:candidateId/subscription
 * (no payment provider webhook exists yet — provider/providerSubId are
 * reserved for that integration and unused until then).
 * PAST_DUE is a grace period, not an immediate downgrade: EntitlementsService
 * still resolves PREMIUM entitlements for up to 7 days after
 * currentPeriodEnd (UPI autopay retries are common) before falling back to
 * FREE — see resolveEffectiveTier's own doc comment for why currentPeriodEnd,
 * not updatedAt, anchors that window. EXPIRED/CANCELED always resolve FREE
 * immediately, no grace. None of this ever revokes an already-issued Badge
 * or a submitted Application — expiry is forward-looking capability only.
 */
model Subscription {
  id                 String             @id @default(uuid())
  candidateId        String             @unique
  candidateProfile   CandidateProfile   @relation(fields: [candidateId], references: [id])
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  /**
   * "razorpay" once a candidate has ever completed checkout through
   * RazorpaySubscriptionGateway; null for a row that only ever came from
   * setTierManually (an admin grant). RazorpayWebhookService keys off
   * providerSubId, never candidateId alone, specifically so a webhook can
   * never touch a row this field marks as admin-owned.
   */
  provider           String?
  /**
   * Razorpay's own subscription id (`sub_...`) once checkout completes —
   * unique per row (Postgres allows multiple NULLs under a unique
   * constraint, so every admin-granted FREE/PREMIUM row with no provider
   * subscription is unaffected). RazorpayWebhookService looks up a row by
   * this field first for every subscription.* event; only the very first
   * event for a given subscription (whichever of activated/charged the
   * out-of-order-tolerant webhook delivery happens to land first) falls
   * back to creating the row from the event payload's own
   * notes.candidateId, exactly the same "pin context into notes, read it
   * back rather than trusting anything else" pattern
   * AssessmentRequestsService.verifyAndCreate already established.
   */
  providerSubId      String?            @unique
  /**
   * Razorpay's own plan id (`plan_...`) for whichever of
   * RAZORPAY_PLAN_ID_MONTHLY/RAZORPAY_PLAN_ID_ANNUAL is currently active —
   * display-only (which cadence a candidate is on), never read by
   * resolveEffectiveTier or PLANS: both plans grant the same PREMIUM tier,
   * only the billing interval differs. Null until a provider-driven write
   * sets it; never set by setTierManually.
   */
  providerPlanId     String?
  /**
   * The `created_at` (converted from Razorpay's Unix-seconds payload) of
   * the most recent RazorpayWebhookEvent actually applied to this row's
   * status/tier/currentPeriodStart/currentPeriodEnd/providerPlanId fields —
   * the out-of-order guard: Razorpay's own docs say webhooks "may not
   * always" arrive in event order, and every subscription.* payload is a
   * full snapshot rather than a diff, so a late-arriving stale event must
   * never overwrite a row a newer event already updated. An incoming
   * event whose own created_at is older than this value is still recorded
   * in RazorpayWebhookEvent (idempotency ledger/audit trail) but its
   * snapshot fields are discarded rather than applied. Null on any row
   * that has never received a provider webhook yet (every admin-granted
   * row, forever).
   */
  lastWebhookEventAt DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/**
 * Append-only ledger of every Razorpay webhook delivery this API has ever
 * accepted (signature-verified) — the idempotency + audit mechanism for
 * RazorpayWebhookService. `id` is Razorpay's own `x-razorpay-event-id`
 * header value, not a generated uuid: that's what makes the very first
 * write of a redelivered event collide on the primary key rather than
 * needing a separate lookup, and it's also the same value Razorpay's own
 * docs point to for de-duplication. `processedAt` is the idempotency gate
 * a retry actually checks: set only once this event's effect on
 * Subscription/Transaction has been fully applied (or correctly determined
 * to be a no-op — a stale out-of-order event, or a pre-activation event
 * with no row to touch yet). A row that exists with processedAt still null
 * means an earlier delivery's processing crashed after this row was
 * inserted but before it finished — the next redelivery (Razorpay retries
 * on any non-2xx for up to 24h) is expected to find exactly this state and
 * safely retry the same apply logic, which is itself idempotent
 * (Subscription writes are a full-snapshot upsert-by-providerSubId;
 * Transaction writes are deduped by providerPaymentId) — never guarded by
 * this table alone. `applied` distinguishes "changed something" from "a
 * legitimate no-op" for anyone reading this table later; both leave
 * processedAt set.
 */
model RazorpayWebhookEvent {
  id            String    @id
  eventType     String
  providerSubId String?
  payload       Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  applied       Boolean   @default(false)

  @@index([providerSubId])
}

/**
 * A monthly, calendar-month-bucketed usage count for one metric (e.g.
 * "assessments", "applications" — see EntitlementGuard/PLANS.*PerMonth).
 * periodStart is always the first instant of a UTC calendar month, so a
 * limit's reset always lands on a real calendar boundary rather than a
 * rolling 30-day window. Checked and incremented atomically inside a
 * transaction (EntitlementsService.checkAndIncrement) — see that method's
 * own doc comment for the concurrency-safety argument, since two
 * simultaneous requests racing this row is the exact failure mode a hard
 * usage cap must never allow through.
 */
model UsageCounter {
  id               String           @id @default(uuid())
  candidateId      String
  candidateProfile CandidateProfile @relation(fields: [candidateId], references: [id])
  metric           String
  periodStart      DateTime
  count            Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([candidateId, metric, periodStart])
}

/**
 * Which employer action produced a ProfileView row — MESSAGE is reserved
 * for a future messaging feature (none exists in this codebase yet, so
 * nothing writes it today); the other four each have a real call site
 * (see ProfileViewsService.record's callers).
 */
enum ProfileViewSource {
  DETAIL_VIEW
  SHORTLIST
  REJECT
  MESSAGE
  STATUS_CHANGE
}

/**
 * One employer's look at one candidate — recorded regardless of the
 * candidate's tier (an upgrading candidate must see real history
 * immediately, not just views from after they upgraded); only the
 * *display* of this data is tier-gated (PLANS.profileViewers:
 * 'count_only' for FREE, 'full' for PREMIUM — see
 * ProfileViewsService.getViewersForCandidate).
 * Deliberately NOT written from list surfaces (GET /candidates/search,
 * GET /jobs/:id/applicants, GET /jobs/:id/matches) — appearing in a list
 * isn't a view, and counting it would inflate the very signal this
 * feature exists to sell. Written from: the single-candidate detail
 * fetch (DETAIL_VIEW) and employer actions that imply the employer
 * actually reviewed this candidate (SHORTLIST, REJECT, STATUS_CHANGE).
 * Deduped to at most one row per (employerId, candidateId, source) per
 * rolling 24h window (see ProfileViewsService.record) — a candidate
 * repeatedly rejecting/re-fetching the same profile shouldn't multiply
 * their own view count.
 */
model ProfileView {
  id               String            @id @default(uuid())
  candidateId      String
  candidateProfile CandidateProfile  @relation(fields: [candidateId], references: [id])
  employerId       String
  employer         User              @relation(fields: [employerId], references: [id])
  source           ProfileViewSource
  viewedAt         DateTime          @default(now())

  @@index([candidateId, viewedAt])
}

// ---------- Job postings (employer side, step 3b) ----------

model Job {
  id              String         @id @default(uuid())
  orgId           String
  organization    Organization   @relation(fields: [orgId], references: [id])
  title           String
  /**
   * Employer-assigned requisition reference (e.g. "JOB-0001"), unique per
   * org — never globally, since two different employers each using
   * "SWE-01" is an expected collision, not a conflict. Normalized to
   * trimmed/uppercase at the service layer before every write (JobsService
   * create/update), so the constraint behaves case-insensitively. Internal
   * to the employer portal — never surfaced to candidates.
   */
  code            String
  description     String
  employmentType  EmploymentType
  /**
   * Structured city selection from GET /locations/search (Google Places
   * Autocomplete — see LocationSearchService), same shape as
   * CandidateProfile's location fields so matching/display compares like
   * with like. locationCity is the presence signal ("has this job been
   * given a structured location yet"). ISO 3166-1 alpha-2 for
   * locationCountry (e.g. "US", "IN") — never a full country name.
   */
  locationCity    String?
  locationRegion  String?
  locationCountry String?
  locationPlaceId String?
  locationLat     Float?
  locationLng     Float?
  /**
   * Pre-migration free-text location value — never silently dropped (see
   * the add_structured_job_location migration's backfill). Jobs whose
   * employer hasn't re-selected a city from the new dropdown yet still
   * show this as their current location; formatLocation shows it only
   * when locationCity is unset. Read-only from the client's point of view
   * going forward — new saves always populate the structured fields
   * above, never this column.
   */
  locationLegacy  String?
  remote          Boolean        @default(false)
  experienceMin   Int?
  experienceMax   Int?
  salaryMin       Int?
  salaryMax       Int?
  status          JobStatus      @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  skills           JobSkill[]
  applications     Application[]
  shortlistEntries ShortlistEntry[]

  @@unique([orgId, code])
  @@index([orgId])
}

model JobSkill {
  id            String     @id @default(uuid())
  jobId         String
  job           Job        @relation(fields: [jobId], references: [id])
  skillId       String
  skill         Skill      @relation(fields: [skillId], references: [id])
  requiredLevel SkillLevel @default(L1)
  isRequired    Boolean    @default(true)

  @@unique([jobId, skillId])
}

// ---------- Applications (candidate side, step 3d) ----------

model Application {
  id                 String            @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id])
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id])
  status             ApplicationStatus @default(APPLIED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  interviewSessions InterviewSession[]

  @@unique([candidateProfileId, jobId])
  @@index([jobId])
}

// ---------- Shortlist (employer portal — hiring-pipeline entry point) ----------

/**
 * One candidate an employer org has collected for hiring-pipeline
 * consideration. jobId is optional: entries created from a job's applicant
 * list or its match results are tied to that job, but entries created from
 * the org-wide candidate search aren't about any one opening, so jobId is
 * null there. @@unique enforces "not shortlisted twice for the same job"
 * (or twice generally, when jobId is null) at the DB level for any given
 * non-null jobId; ShortlistService.add is the actual idempotency guarantee
 * for callers (see its own doc comment) since Postgres treats NULL as
 * distinct in unique constraints, so the null-jobId case isn't fully
 * DB-enforced.
 */
model ShortlistEntry {
  id               String           @id @default(uuid())
  orgId            String
  organization     Organization     @relation(fields: [orgId], references: [id])
  candidateId      String
  candidateProfile CandidateProfile @relation(fields: [candidateId], references: [id])
  jobId            String?
  job              Job?             @relation(fields: [jobId], references: [id])
  addedByUserId    String
  addedByUser      User             @relation(fields: [addedByUserId], references: [id])
  stage            ShortlistStage   @default(SHORTLISTED)
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /**
   * Employer-authored, sent with the SHORTLISTED→INVITED transition. Candidate-visible — it's addressed to them.
   */
  inviteMessage String?
  /**
   * Employer-authored, sent with the →REJECTED transition. Deliberately
   * NOT exposed on GET /interviews/mine — same "employer-only" treatment as
   * InterviewRound.note, for the same reason (an internal reason isn't
   * necessarily something to hand a rejected candidate verbatim).
   */
  rejectReason  String?

  /**
   * The candidate's own write on an OFFER-stage entry — see
   * CandidateOfferResponse's doc comment. Settable only while stage is
   * still OFFER (ShortlistPipelineService/InterviewsService both enforce
   * this); once the employer's outcome write moves stage to HIRED/CLOSED,
   * this value is frozen as the historical record of what the candidate
   * said at the time, which may or may not match the outcome. Never
   * overwritten by, and never overwrites, `stage`.
   */
  candidateResponse CandidateOfferResponse?

  /**
   * The stage this entry was in immediately before AccountService moved it
   * to CANDIDATE_UNAVAILABLE — null unless stage is currently
   * CANDIDATE_UNAVAILABLE. Restored verbatim on reactivation (see
   * AccountService.reactivate), same "remember what to revert to" role
   * AssessmentSession.preDisputeStatus already plays for disputes
   * elsewhere in this schema. Left permanently set (not cleared) once a
   * deletion makes the transition irreversible — harmless, since nothing
   * reads it once stage can never leave CANDIDATE_UNAVAILABLE again.
   */
  preUnavailableStage ShortlistStage?

  rounds InterviewRound[]

  @@unique([orgId, candidateId, jobId])
  @@index([orgId, stage])
  @@index([jobId])
  @@index([candidateId])
}

// ---------- Employer-triggered candidate assessments (pay-per-assessment,
// Option C: pay-then-refund — see AssessmentRequestsService's own doc
// comment for why, and its state machine). Deliberately separate from
// Subscription/SubscriptionTier above — this is a one-off employer
// purchase, not a candidate plan. ----------

enum AssessmentRequestStatus {
  /**
   * Payment captured, candidate invited, waiting for them to start within expiresAt.
   */
  PAID_PENDING_START
  /**
   * Candidate started within the window — attemptId/sessionId is now set. Terminal for refund purposes: a STARTED request is never refunded.
   */
  STARTED
  /**
   * The linked attempt/session reached a terminal decision (pass or fail) — badgeId set if it passed.
   */
  COMPLETED
  /**
   * Candidate never started within the 5-day window; the $5 was refunded.
   */
  EXPIRED_REFUNDED
  /**
   * Expiry job attempted the refund and it failed — retried on the job's next run, never silently dropped.
   */
  REFUND_FAILED
  /**
   * Candidate already held a verified badge at the requested skill+level — set at creation, no payment ever taken. Terminal from the start.
   */
  ALREADY_BADGED
}

/**
 * One employer's request to verify a specific candidate at a specific
 * skill+level, triggered from the shortlist/pipeline. See
 * AssessmentRequestsService for the full state machine and payment flow;
 * this model is deliberately a thin data record — every transition and
 * every Razorpay call lives in the service, not here.
 */
model AssessmentRequest {
  id String @id @default(uuid())

  orgId             String
  organization      Organization     @relation(fields: [orgId], references: [id])
  requestedByUserId String
  requestedByUser   User             @relation("AssessmentRequestRequestedBy", fields: [requestedByUserId], references: [id])
  /**
   * CandidateProfile.id — matches ShortlistEntry.candidateId's own convention, since every request originates from a ShortlistEntry.
   */
  candidateId       String
  candidateProfile  CandidateProfile @relation(fields: [candidateId], references: [id])
  skillId           String
  skill             Skill            @relation(fields: [skillId], references: [id])
  level             SkillLevel

  status AssessmentRequestStatus @default(PAID_PENDING_START)

  /**
   * Paise. Server-decided at creation time — never trust a client-supplied amount. Null only for ALREADY_BADGED, which never charges.
   */
  amount Int?

  razorpayOrderId   String?
  razorpayPaymentId String?
  /**
   * Set only once a refund actually succeeds — the double-refund guard the expiry job checks before ever calling Razorpay again.
   */
  razorpayRefundId  String?

  paidAt    DateTime?
  /**
   * paidAt + 5 days. Null for ALREADY_BADGED (never paid, nothing to expire).
   */
  expiresAt DateTime?
  startedAt DateTime?

  attemptId String?            @unique
  attempt   Attempt?           @relation(fields: [attemptId], references: [id])
  sessionId String?            @unique
  session   AssessmentSession? @relation(fields: [sessionId], references: [id])
  badgeId   String?            @unique
  badge     Badge?             @relation(fields: [badgeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([candidateId])
  // The expiry job's own query shape: PAID_PENDING_START/REFUND_FAILED rows whose window has passed.
  @@index([status, expiresAt])
}

/**
 * One interview round on a ShortlistEntry, employer-driven and repeatable —
 * there is no fixed count; the employer adds the next round when ready.
 * roundNumber is server-assigned (see ShortlistPipelineService.addRound),
 * never client-supplied, so ordering can't be gamed or gapped.
 */
model InterviewRound {
  id               String               @id @default(uuid())
  shortlistEntryId String
  shortlistEntry   ShortlistEntry       @relation(fields: [shortlistEntryId], references: [id])
  roundNumber      Int
  status           InterviewRoundStatus @default(SCHEDULED)
  /**
   * Zoom/Meet link, phone number, "we'll email you" — free text the candidate reads, not validated as a URL.
   */
  channel          String?
  scheduledAt      DateTime?
  /**
   * Employer-only — never returned by GET /interviews/mine.
   */
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([shortlistEntryId, roundNumber])
  @@index([shortlistEntryId])
}

// ---------- Interview question bank (practice prep — data only, no session/scoring logic) ----------

enum InterviewQuestionCategory {
  PROBLEM_SOLVING
  CONFLICT
  TEAMWORK
  INITIATIVE
  MOTIVATION
  SELF_AWARENESS
  AMBITION
  INDUSTRY_AWARENESS
  CULTURE_FIT
  COMMUNICATION
}

/**
 * One behavioral practice-interview question. Purely a content bank —
 * nothing here runs a session or scores an answer; a future AI-assessor-
 * style consumer reads from this table, same relationship this schema
 * already has between Assessment (content) and AttemptSession (session
 * logic) elsewhere in this file.
 * expectedElements IS NOT A CHECKLIST. It's a STAR-shaped *illustrative
 * reference point* — one plausible strong answer's shape, written by the
 * product owner as a calibration example — describing what a strong
 * answer *tends to* contain. Any consumer that scores a candidate's answer
 * must evaluate whether their response has complete STAR structure
 * (a real situation, a clear task, concrete actions, a stated result) and
 * sound reasoning throughout — never whether it happens to mention the
 * specific tactics or nouns listed here. A candidate whose situation was
 * "a supplier went bankrupt" scores identically to one whose situation
 * matches this row's example verbatim, provided both have the same
 * structural completeness and reasoning quality. Implementing this as
 * keyword/substring matching against expectedElements would silently and
 * incorrectly penalize every candidate whose real experience doesn't
 * happen to match the specific example on file.
 */
model InterviewQuestion {
  id       String                    @id @default(uuid())
  text     String
  category InterviewQuestionCategory

  /**
   * The evaluative intent — what trait(s) this question is actually
   * probing for (e.g. "agility, emotional control, structured pivoting
   * without panic"), independent of any specific answer content.
   */
  whatToLookFor String

  /**
   * { situation, task, action, result } — see this model's own doc
   * comment above for why this is a reference point, not a checklist.
   * Stored as Json rather than four columns so future categories or
   * question types can extend the shape without a migration; every seeded
   * row today uses exactly these four string keys.
   */
  expectedElements Json

  /**
   * Optional deeper-probe questions an interviewer/AI assessor can ask
   * if the candidate's initial answer is thin — empty for a question with
   * none authored yet, never inferred or auto-generated from the question text.
   */
  followUpProbes String[] @default([])

  /**
   * True only for a question that references this specific company's
   * product, values, or situation by name — false for every generic
   * behavioral question, including all of INDUSTRY_AWARENESS (which is
   * deliberately evergreen; see the seed script's own doc comment on why
   * it never references current events).
   */
  isCompanyGrounded Boolean @default(false)

  /**
   * False retires a question from rotation (e.g. it's dated, or a
   * near-duplicate was added) without deleting history of it having been
   * asked. Toggled via the admin endpoint, never a hard delete.
   */
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns    InterviewTurn[]
  feedback InterviewAnswerFeedback[]

  @@index([category])
  @@index([active])
}

enum InterviewSessionStatus {
  IN_PROGRESS
  EXPIRED
  /**
   * All turns done; the batched end-of-session feedback pass hasn't
   * finished yet (or failed — see feedbackError).
   */
  AWAITING_FEEDBACK
  COMPLETED
}

/**
 * The seven ordered phases the orchestrator walks through — see
 * interview-orchestrator.ts's own doc comment for the transition rules and
 * per-phase target exchange counts. SCORING is not a conversational
 * phase (no candidate turn happens in it); it's the terminal marker set
 * once CLOSING's message is sent, the same role AssessmentSession's
 * AWAITING_SCORING plays for the technical assessor.
 */
enum InterviewSessionPhase {
  OPENING
  MOTIVATION
  BEHAVIORAL
  INDUSTRY_AWARENESS
  CANDIDATE_QUESTIONS
  CLOSING
  SCORING
}

enum InterviewTurnRole {
  CANDIDATE
  COACH
}

/**
 * A mock-interview practice session — coaching, not assessment. This is
 * deliberately isolated from AssessmentSession/SkillClaim/Badge: nothing in
 * this model or its relations ever mints a badge or feeds scoring.ts /
 * matching.service.ts. That separation is what protects the credibility of
 * verified badges with employers — a candidate practicing behavioral
 * answers must never be confused, by the data model or by anything
 * downstream, with a candidate whose skills were actually verified.
 * phaseState is the orchestrator's persisted position — see
 * InterviewOrchestratorState in interview-orchestrator.ts. Never exposed to
 * the client raw (see InterviewSessionsService.toPublicSession); the phase
 * name and a coarse progress count are the only pieces of it a candidate
 * ever sees.
 */
model InterviewSession {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id])
  /**
   * Set at session creation from the candidate's own most recent
   * Application (or an applicationId they pass explicitly) — see
   * InterviewSessionsService.createSession. Null means no application
   * exists yet; company-grounded touches are skipped in that case, never
   * faked with a generic placeholder employer.
   */
  applicationId  String?
  application    Application?           @relation(fields: [applicationId], references: [id])
  status         InterviewSessionStatus @default(IN_PROGRESS)
  phaseState     Json
  /**
   * Candidate + coach turns combined — checked against the session turn
   * cap on every postTurn call, independent of the idle-timeout/duration
   * cap below (see MAX_SESSION_TURNS in interview-sessions.service.ts).
   */
  turnCount      Int                    @default(0)
  startedAt      DateTime               @default(now())
  lastActivityAt DateTime               @default(now())
  /**
   * Idle-timeout boundary, same "resume, don't restart" role as
   * AssessmentSession.expiresAt — not the hard session-duration cap, which
   * is computed from startedAt instead (see MAX_SESSION_DURATION_MINUTES).
   */
  expiresAt      DateTime
  completedAt    DateTime?
  /**
   * Set when the batched end-of-session feedback pass fails — session
   * stays AWAITING_FEEDBACK and retryable rather than silently losing the
   * transcript. Cleared on a successful retry.
   */
  feedbackError  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  turns    InterviewTurn[]
  feedback InterviewAnswerFeedback[]

  @@index([userId])
}

/**
 * One message in an interview session. questionId is set on both the COACH
 * turn that asked a bank question and the CANDIDATE turn answering it (same
 * denormalization AssessmentSessionsService uses for claimId/probeRung) —
 * null for OPENING/CANDIDATE_QUESTIONS/CLOSING turns and for follow-up
 * probes, which aren't bank questions themselves.
 */
model InterviewTurn {
  id         String                @id @default(uuid())
  sessionId  String
  session    InterviewSession      @relation(fields: [sessionId], references: [id])
  role       InterviewTurnRole
  content    String
  phase      InterviewSessionPhase
  questionId String?
  question   InterviewQuestion?    @relation(fields: [questionId], references: [id])
  /**
   * Re-asked-after-idle fragment, same meaning as SessionTurn.superseded —
   * dropped from the model's context and the scored transcript, kept
   * (struck through) in the candidate-facing history.
   */
  superseded Boolean               @default(false)
  createdAt  DateTime              @default(now())

  answerFeedback InterviewAnswerFeedback?

  @@index([sessionId])
}

/**
 * One bank question's worth of coaching feedback, written in the single
 * batched pass at session end (see InterviewFeedbackService) — never
 * generated per-answer during the live conversation, so nothing about how
 * the candidate is doing leaks mid-session. missingStarElement names the
 * weakest/absent STAR component when one is clearly missing — situation,
 * task, action, or result, as literal lowercase strings matching
 * InterviewQuestion.expectedElements' own keys — or null when the answer
 * had complete STAR structure. This is scored against structure and
 * reasoning quality in the candidate's *own* answer, never against whether
 * it echoes expectedElements' specific example content — see
 * InterviewQuestion's own doc comment.
 */
model InterviewAnswerFeedback {
  id                 String             @id @default(uuid())
  sessionId          String
  session            InterviewSession   @relation(fields: [sessionId], references: [id])
  candidateTurnId    String             @unique
  candidateTurn      InterviewTurn      @relation(fields: [candidateTurnId], references: [id])
  questionId         String?
  question           InterviewQuestion? @relation(fields: [questionId], references: [id])
  missingStarElement String?
  summary            String
  strengths          Json
  improvements       Json
  createdAt          DateTime           @default(now())

  @@index([sessionId])
}

// ---------- Notifications (spec section: email, step 3e) ----------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      NotificationType
  channel   NotificationChannel @default(EMAIL)
  subject   String
  body      String
  status    NotificationStatus  @default(QUEUED)
  // Job ids this notification already covered — populated for MATCH_DIGEST
  // (so the daily digest job can exclude jobs a candidate has already been
  // told about instead of re-sending the same match forever) and for
  // JOB_UNPUBLISHED (so a candidate is never told about the same job's
  // closure twice, even across an unpublish -> republish -> unpublish
  // cycle — see JobsService.notifyJobUnpublished). Empty/unused for every
  // other notification type.
  jobIds    String[]            @default([])
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
}

// ---------- Assessments (spec section 4.4) ----------

model Assessment {
  id                  String     @id @default(uuid())
  skillId             String
  skill               Skill      @relation(fields: [skillId], references: [id])
  title               String
  targetLevel         SkillLevel
  durationMins        Int        @default(30)
  // Server-enforced deadline = Attempt.startedAt + durationMins. This is
  // also the field the task brief calls "timeLimitMinutes" — durationMins
  // already existed and means the same thing, so it's reused rather than
  // duplicated (see AssessmentsService.deadlineFor).
  passThreshold       Int        @default(70)
  // Also existing — a 0-100 percentage compared against scorePercent in
  // gradeAttempt(), not a separate 0-1 fraction field.
  questionsPerAttempt Int        @default(20)
  isPremium           Boolean    @default(false)
  isLive              Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  questions Question[]
  attempts  Attempt[]
}

model Question {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  type         String     @default("MCQ") // MCQ | CODING | PROMPT_TASK
  body         Json // question text + options (safe to send to client)
  correct      Json // answers/rubric — NEVER send to client
  difficulty   Int        @default(2)
  isLive       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  answers          AttemptAnswer[]
  servedTimestamps QuestionServedAt[]
}

model Attempt {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  assessmentId  String
  assessment    Assessment    @relation(fields: [assessmentId], references: [id])
  status        AttemptStatus @default(CREATED)
  startedAt     DateTime?
  submittedAt   DateTime?
  scorePercent  Int?
  passed        Boolean?
  /**
   * This candidate's ordinal attempt number for the attempt's skill (across
   * every level of that skill, not just this exact assessment) — 1 for a
   * skill's very first attempt, 2+ for a retake. Set once at creation by
   * EntitlementsService.checkRetakeEligibility (the same call that enforces
   * retakeCooldownDays/retakesPerSkillLifetime — see that method's doc
   * comment for exactly what counts as a prior attempt), never recomputed
   * or updated afterward. Copied onto Badge.attemptNumber at issuance so
   * "earned on attempt #N" survives independently of this row — see that
   * field's own doc comment for why. Backfilled for pre-existing rows by
   * the introducing migration using the same per-(user, skill) ordering.
   */
  attemptNumber Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Integrity monitoring — aggregate counters kept in sync with IntegrityEvent
  // rows by AssessmentsService (see addIntegrityEvent); never written by the client.
  integrityFlagCount Int             @default(0)
  integrityStatus    IntegrityStatus @default(CLEAN)

  // Admin review of a FLAGGED attempt (AdminService.reviewAttempt) — the only
  // path that can move an attempt to INVALIDATED and revoke its badge.
  // Null until an admin actually reviews it.
  reviewOutcome    ReviewOutcome?
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedByUser   User?          @relation("AttemptReviewedBy", fields: [reviewedByUserId], references: [id])

  answers           AttemptAnswer[]
  badge             Badge?
  integrityEvents   IntegrityEvent[]
  questionsServed   QuestionServedAt[]
  assessmentRequest AssessmentRequest?
}

/**
 * One detected integrity signal for an attempt — a tab blur, a paste, an
 * implausibly-fast answer, etc. This is an audit trail, not a verdict: each
 * row records what was observed, never a conclusion. `metadata` is a free-form
 * JSON bag (e.g. { questionId, elapsedMs } for RAPID_ANSWER) so new event
 * types — including a future webcam/proctoring tier — can attach whatever
 * detail they need without a schema change.
 */
model IntegrityEvent {
  id        String             @id @default(uuid())
  attemptId String
  attempt   Attempt            @relation(fields: [attemptId], references: [id])
  type      IntegrityEventType
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([attemptId])
}

/**
 * Server-recorded "this question was served to the candidate at this time"
 * — one row per (attempt, question), created when the question set is first
 * fetched and refreshed (bumped to "now") for every still-unanswered question
 * whenever any other answer lands. That refresh is what makes RAPID_ANSWER a
 * genuine per-question signal instead of one dominated by time already spent
 * on earlier questions — see AssessmentsService.checkRapidAnswer /
 * refreshServedTimestamps. Never written from anything client-reported.
 */
model QuestionServedAt {
  id         String   @id @default(uuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  servedAt   DateTime @default(now())

  @@unique([attemptId, questionId])
}

model AttemptAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  answer     Json
  isCorrect  Boolean?
  createdAt  DateTime @default(now())

  @@unique([attemptId, questionId])
}

/**
 * Issued from exactly one of two sources, never both — MCQ attempts
 * (AssessmentsService.issueBadge) or reviewed conversational sessions
 * (ReviewService.issueBadge, only via POST /assessment-sessions/:id/decision
 * ISSUE). Both attemptId and sessionId are nullable rather than a shared
 * required FK because the two source models are unrelated; each issuance
 * path only ever sets its own column. No DB-level "exactly one" constraint —
 * enforced by there being exactly two controlled call sites, same as the
 * rest of this schema's soft invariants.
 * Every passing attempt/session mints its own Badge row — this table is a
 * permanent, immutable log of evidence, never pruned or overwritten. skillId
 * is stored directly (not just derivable via attempt.assessment.skillId)
 * because session-issued badges have no other path to their skill at all —
 * see BadgeResolverService's doc comment for why precedence has to be
 * resolved at read time across potentially several Badge rows for the same
 * user+skill+level, rather than by mutating this table.
 */
model Badge {
  id            String                  @id @default(uuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id])
  skillId       String
  skill         Skill                   @relation(fields: [skillId], references: [id])
  attemptId     String?                 @unique
  attempt       Attempt?                @relation(fields: [attemptId], references: [id])
  sessionId     String?                 @unique
  session       AssessmentSession?      @relation(fields: [sessionId], references: [id])
  verifiedBy    BadgeVerificationMethod
  verifyHash    String                  @unique
  level         SkillLevel
  issuedAt      DateTime                @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  /**
   * Copied from Attempt.attemptNumber at issuance (AssessmentsService.issueBadge)
   * — employer-facing credibility ("earned on attempt #N") depends on this
   * surviving independently of the Attempt row. Null for session-issued
   * badges (ReviewService.issueBadge) — the discussion format has its own,
   * separate retake/cooldown system (AssessmentSession.preDisputeStatus /
   * ClaimDispute) and isn't in scope for the attemptNumber feature.
   */
  attemptNumber Int?

  skillClaim        SkillClaim?
  assessmentRequest AssessmentRequest?

  @@index([userId, skillId, level])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Conversational AI assessor sessions (RAG Systems L2, text-based) ----------

enum AssessmentSessionStatus {
  IN_PROGRESS
  AWAITING_SCORING
  AWAITING_REVIEW
  EXPIRED
  // Terminal decision outcomes — set only by ReviewService.decide, and only
  // once every ClaimVerdict has a reviewerVerdict. ISSUE also mints a Badge
  // (see ReviewService.issueBadge); REJECT never does.
  ISSUED
  REJECTED
  // Set by a candidate disputing a claim on an already-decided (ISSUED or
  // REJECTED) session (see AssessmentSessionsService.disputeClaim). Reappears
  // in the admin review queue flagged as disputed. Resolved by
  // AssessmentSessionsService.resolveDispute, which reverts the session to
  // AssessmentSession.preDisputeStatus once no disputes remain unresolved.
  DISPUTED
}

/**
 * The six claims in the RAG Systems L2 rubric (see rag-systems-l2.rubric.ts
 * in the assessment-sessions module for the probe content per claim). Order
 * here is cosmetic — CLAIM_ORDER in that file is what actually drives the
 * ladder walk.
 */
enum RagL2Claim {
  CHUNKING
  DIAGNOSIS
  RERANKING
  CORPUS_CHANGE
  EVALUATION
  COST
}

enum ProbeRung {
  OPENING
  FOLLOWUP
  CONSTRAINT
}

enum SessionTurnRole {
  CANDIDATE
  ASSESSOR
}

/**
 * One live conversational assessment. ladderState is the single source of
 * truth for "where the ladder walk currently is" (see AssessorService's
 * LadderState type) — a resumed session re-reads it and re-asks exactly the
 * probe that was outstanding, rather than restarting. pinnedBrief is a
 * denormalized copy of the scenario text handed to the candidate at session
 * start, kept separate from the turn transcript so the client can keep it
 * pinned on screen without re-parsing the opening turn.
 */
model AssessmentSession {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id])
  status           AssessmentSessionStatus  @default(IN_PROGRESS)
  pinnedBrief      String
  ladderState      Json
  // Copied onto every ClaimVerdict scored from this session (see
  // ScoringService) — RUBRIC_VERSION in rag-systems-l2.rubric.ts is the
  // single source of truth; this just pins which version a given session
  // was run/scored against, since the rubric text itself is not versioned
  // in the DB.
  rubricVersion    String                   @default("rag-systems-l2-r2")
  startedAt        DateTime                 @default(now())
  lastActivityAt   DateTime                 @default(now())
  expiresAt        DateTime
  // Set once ScoringService.scoreSession finishes successfully (status ->
  // AWAITING_REVIEW). scoringError is populated instead when scoring fails,
  // so a broken session stays visibly AWAITING_SCORING and retryable via
  // POST /assessment-sessions/:id/score rather than vanishing silently.
  scoredAt         DateTime?
  scoringError     String?
  // Set once by ReviewService.decide (ISSUED or REJECTED) — never touched
  // again afterward. decisionNote carries the REJECT reason, or an optional
  // note on ISSUE.
  decidedAt        DateTime?
  decidedByUserId  String?
  decidedByUser    User?                    @relation("SessionDecidedBy", fields: [decidedByUserId], references: [id])
  decisionNote     String?
  // The status just before a dispute flipped this session to DISPUTED —
  // cleared once resolveDispute reverts to it (see
  // AssessmentSessionsService.disputeClaim/resolveDispute). Never touched by
  // anything but those two methods; decidedAt is never touched by disputing
  // either, so the original decision timestamp — and the retake cooldown
  // computed from it — survives a dispute untouched.
  preDisputeStatus AssessmentSessionStatus?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  turns             SessionTurn[]
  interruptions     SessionInterruption[]
  claimVerdicts     ClaimVerdict[]
  disputes          ClaimDispute[]
  liveClaimFeedback LiveClaimFeedback[]
  badge             Badge?
  assessmentRequest AssessmentRequest?

  @@index([userId])
}

/**
 * One message in the conversation. claimId/probeRung record which ladder
 * position this turn targets (the probe an ASSESSOR turn is asking, or the
 * probe a CANDIDATE turn is answering) — both null for reflection-stage
 * turns, which aren't scored against any claim. superseded marks a turn
 * that was re-asked after a resume (see AssessmentSessionsService.resume) —
 * superseded turns are excluded from the conversation history sent to the
 * model and from the candidate-facing transcript, but kept for audit.
 */
model SessionTurn {
  id         String            @id @default(uuid())
  sessionId  String
  session    AssessmentSession @relation(fields: [sessionId], references: [id])
  role       SessionTurnRole
  content    String
  claimId    RagL2Claim?
  probeRung  ProbeRung?
  superseded Boolean           @default(false)
  createdAt  DateTime          @default(now())

  // Optional, candidate-turn-only composition telemetry (paste/timing/focus)
  // — see TurnSignals' own doc comment. Kept as a separate related model
  // rather than columns here so a plain `sessionTurn.findMany()` (exactly
  // what ScoringService uses) never brings this data along; it only
  // surfaces where something explicitly does `include: { signals: true }`,
  // which the scoring path never does.
  signals TurnSignals?

  @@index([sessionId])
}

/**
 * Composition telemetry captured client-side for one CANDIDATE turn —
 * paste activity, timing, and window-focus behavior while writing that
 * answer. Neutral context for the human reviewer only (see ReviewService's
 * signal-summary helpers): never a score, never a flag, never read by
 * ScoringService's extractor/adjudicator. Every field is nullable — older
 * sessions predate this table entirely (no row at all), and any client that
 * fails to report a given metric (or all of them) must not break turn
 * submission; POST .../turns persists whatever subset arrives, or no row if
 * the client sent nothing.
 */
model TurnSignals {
  id            String      @id @default(uuid())
  sessionTurnId String      @unique
  sessionTurn   SessionTurn @relation(fields: [sessionTurnId], references: [id])

  // Paste activity while composing this turn.
  pasteCount        Int?
  pastedCharCount   Int?
  largestPasteChars Int?

  // Timing: assessor turn rendered -> first keystroke -> send.
  timeToFirstKeystrokeMs Int?
  compositionDurationMs  Int?
  charCount              Int?
  // Derived (charCount / 5 chars-per-word ÷ compositionDurationMs), stored
  // rather than recomputed so the reviewer view and any later analysis agree
  // on the exact same number the client observed.
  effectiveWpm           Float?

  // Window focus while this turn had content or focus.
  blurCount      Int?
  blurDurationMs Int?

  createdAt DateTime @default(now())
}

/**
 * Audit trail for a session going EXPIRED (idle timeout) and, once resumed,
 * how that resume was handled. fragmentTurnId points at the ASSESSOR turn
 * that was outstanding when the session broke — the one marked superseded
 * and re-asked fresh on resume (see resume() in the service).
 */
model SessionInterruption {
  id             String            @id @default(uuid())
  sessionId      String
  session        AssessmentSession @relation(fields: [sessionId], references: [id])
  occurredAt     DateTime          @default(now())
  resumedAt      DateTime?
  fragmentTurnId String?
  createdAt      DateTime          @default(now())

  @@index([sessionId])
}

enum Verdict {
  DEMONSTRATED
  PARTIAL
  NOT_EVIDENCED
  ABSTAIN
  // Reviewer-only — the model never produces this (ScoringService's own
  // record_verdict tool schema is still restricted to the four values
  // above). Means the assessor failed to elicit evidence on this claim at
  // all — a verdict about the session/assessor, not the candidate. Blocks
  // ISSUE for the gating claims (see ReviewService's level rule) in favor
  // of offering a re-take, never a rejection.
  INSUFFICIENT_PROBING
}

/**
 * The AI-scored outcome for one claim in one session (see ScoringService).
 * The model.../reviewer... column split is deliberate and permanent: the
 * model's original verdict/bandBoundary/reason/confidence are written once
 * at scoring time and never touched again — verdict/bandBoundary/reason are
 * the "working" columns a human reviewer can override via reviewerVerdict
 * etc. The gap between the model columns and the reviewer columns across
 * enough sessions is the calibration dataset that eventually justifies
 * auto-issue; overwriting the model columns on review would destroy that
 * signal. modelConfidence is captured for the same calibration purpose and
 * deliberately unused elsewhere — triage keys off bandBoundary/ABSTAIN, not
 * confidence (near-constant in harness runs, not a real judgment signal).
 * reviewerVerdict/reviewerId/reviewerNote/reviewedAt are write-once — see
 * ReviewService.reviewClaim's 409 on a second attempt; a mistaken review is
 * corrected by a second reviewer's note later, never by overwriting.
 */
model ClaimVerdict {
  id            String            @id @default(uuid())
  sessionId     String
  session       AssessmentSession @relation(fields: [sessionId], references: [id])
  claimId       RagL2Claim
  rubricVersion String

  // Working columns — start identical to the model's output, but this is
  // the pair a human reviewer's override should land in eventually (no
  // reviewer-write path exists yet; that's a future admin action).
  verdict      Verdict
  bandBoundary Boolean
  reason       String

  // Immutable copies of pass 2's original output — never overwritten.
  modelVerdict      Verdict
  modelBandBoundary Boolean
  modelReason       String
  modelConfidence   Float

  // Extracted evidence (pass 1 output, filtered to this claim) that pass 2
  // adjudicated from — [{quote, probeContext}], quotes verbatim from the
  // candidate's own turns. Kept for reviewer audit without re-reading the
  // whole transcript.
  spans Json

  reviewerVerdict Verdict?
  reviewerId      String?
  reviewerUser    User?     @relation("ClaimVerdictReviewedBy", fields: [reviewerId], references: [id])
  reviewerNote    String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([sessionId, claimId])
  @@index([sessionId])
}

/**
 * A candidate's dispute of one claim's reviewed verdict, filed from the
 * results page (see AssessmentSessionsService.disputeClaim) — only possible
 * once a session is decided (ISSUED/REJECTED), and only once per claim
 * (@@unique below — a second attempt on the same claim 409s). Filing a
 * dispute flips the session to DISPUTED, which folds it back into the admin
 * review queue as a flagged case (see ScoringService.getReviewQueue).
 * resolvedAt/resolution are nullable and unused by any endpoint yet — they
 * exist for a future admin resolution action, not wired up in this pass.
 */
model ClaimDispute {
  id          String            @id @default(uuid())
  sessionId   String
  session     AssessmentSession @relation(fields: [sessionId], references: [id])
  claimId     RagL2Claim
  candidateId String
  body        String
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?
  resolution  String?
  // Set together with resolvedAt/resolution by
  // AssessmentSessionsService.resolveDispute — null until resolved. An
  // upheld dispute (the reviewer's verdict was wrong) exempts the session
  // from the retake cooldown once reverted to REJECTED, the same way
  // Verdict.INSUFFICIENT_PROBING does: it's a fault of the process, not the
  // candidate. See isRetakeCooldownExempt.
  upheld      Boolean?

  @@unique([sessionId, claimId])
  @@index([sessionId])
}

/**
 * Informal, candidate-facing coaching note for one completed claim — generated once that
 * claim's ladder walk finishes (see AssessmentSessionsService.postTurn). Deliberately distinct
 * from ClaimVerdict/ScoringService: this is shown live, is never the official scored verdict,
 * and is never read by ScoringService or ReviewService. helpfulVote is upsertable (a low-stakes
 * UI toggle), not write-once like ClaimDispute.
 */
model LiveClaimFeedback {
  id           String            @id @default(uuid())
  sessionId    String
  session      AssessmentSession @relation(fields: [sessionId], references: [id])
  claimId      RagL2Claim
  verdictLabel String
  // Drives the verdict chip's color/icon — a structured field, not
  // something the UI infers from verdictLabel text, so the chip can never
  // contradict the label (see LiveFeedbackService's tool schema, which
  // requires the model to set this consistently with the label/gaps it
  // wrote in the same call). Nullable because it was added after
  // verdictLabel existed; the migration backfills every pre-existing row
  // (inferred from label text, defaulting to MIXED) rather than leaving
  // real gaps, but stays nullable in case a future row somehow lands
  // without one.
  verdictTone  LiveFeedbackTone?
  summary      String
  strengths    Json
  gaps         Json
  helpfulVote  Boolean?
  votedAt      DateTime?
  createdAt    DateTime          @default(now())

  @@unique([sessionId, claimId])
  @@index([sessionId])
}

enum LiveFeedbackTone {
  POSITIVE
  MIXED
  NEEDS_WORK
}
